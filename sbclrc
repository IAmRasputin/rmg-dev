;;; The following lines added by ql:add-to-init-file:
#-quicklisp
(let ((quicklisp-init (merge-pathnames "quicklisp/setup.lisp"
                                       (user-homedir-pathname))))
  (when (probe-file quicklisp-init)
    (load quicklisp-init)))

(setf *compile-verbose* nil) ;; shh!
(declaim (sb-ext:muffle-conditions cl:warning)) ;; might be bad idk lol

#+quicklisp
(push #p"~/code/Lisp/" ql:*local-project-directories*)

(defun :cd (path)
  (uiop:chdir path)
  (setf *default-pathname-defaults* (truename path)))

#-ocicl
(when (probe-file #P"/home/rmg/.local/share/ocicl/ocicl-runtime.lisp")
  (load #P"/home/rmg/.local/share/ocicl/ocicl-runtime.lisp"))

#+ocicl
(progn
  (pushnew #p"~/code/Lisp/" asdf:*central-registry* :test 'equalp)
  (pushnew (uiop:getcwd) asdf:*central-registry* :test 'equalp)
  (asdf:initialize-source-registry '(:source-registry :inherit-configuration (:tree #p"~/code/Lisp/"))))

(if (member "--no-linedit" sb-ext:*posix-argv* :test 'equal)
    (setf sb-ext:*posix-argv* 
	  (remove "--no-linedit" sb-ext:*posix-argv* :test 'equal))
    (when (interactive-stream-p *terminal-io*)
      (require :sb-aclrepl)
      (require :linedit)
      (funcall (intern "INSTALL-REPL" :linedit) :wrap-current t :eof-quits t)))
